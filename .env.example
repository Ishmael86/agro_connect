# -----------------------------------------------------------------------------
# AgroConnect Environment Configuration Template
# Duplicate this file as '.env' and fill in the values for local or production use.
# -----------------------------------------------------------------------------

# Security settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (if using dj_database_url in production)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# SendGrid Production Email Settings
# Set SENDGRID_API_KEY to automatically route emails through SendGrid SMTP backend
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
DEFAULT_FROM_EMAIL=AgroConnect Support <noreply@yourdomain.com>

# Development Fallback Email Settings (Gmail SMTP)
# Used only if SENDGRID_API_KEY is not defined
EMAIL_HOST_USER=your-gmail-username@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
SERVER_EMAIL=your-gmail-username@gmail.com

# Paystack Payment API keys
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
